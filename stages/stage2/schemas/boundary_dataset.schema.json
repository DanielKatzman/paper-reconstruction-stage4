{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/paper-reconstruction/stage2/boundary-dataset.v1.schema.json",
  "title": "Stage 2 Boundary Dataset Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_version",
    "canonical_dataset_fingerprint",
    "observation_dataset_fingerprint",
    "boundary_dataset_fingerprint",
    "boundary_config",
    "puzzle_count",
    "observation_count",
    "boundary_point_count",
    "correspondence_track_count",
    "usable_correspondence_track_count",
    "matchable_seam_count",
    "missing_matchable_owner_track_count",
    "split_counts",
    "puzzles"
  ],
  "properties": {
    "schema_version": {"const": "stage2.boundary-dataset.v1"},
    "boundary_dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "puzzle_count": {"type": "integer", "minimum": 0},
    "observation_count": {"type": "integer", "minimum": 0},
    "boundary_point_count": {"type": "integer", "minimum": 0},
    "correspondence_track_count": {"type": "integer", "minimum": 0},
    "usable_correspondence_track_count": {"type": "integer", "minimum": 0},
    "matchable_seam_count": {"type": "integer", "minimum": 0},
    "missing_matchable_owner_track_count": {"type": "integer", "minimum": 0},
    "puzzles": {"type": "array"}
  },
  "additionalProperties": true
}
