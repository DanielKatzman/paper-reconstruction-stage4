{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-reconstruction.local/schemas/stage1_segmentation_manifest_compat.schema.json",
  "title": "Stage 1 segmentation manifest row required by Stage 2 v1.0",
  "description": "Compatibility subset only. The Stage 1 repository's segmentation_manifest.schema.json remains authoritative.",
  "type": "object",
  "required": [
    "schema_version",
    "capture_id",
    "original_size_hw",
    "bbox_xywh",
    "piece_path",
    "piece_mask_path",
    "accepted"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "capture_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "original_size_hw": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "bbox_xywh": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "piece_path": {"type": "string", "minLength": 1},
    "piece_mask_path": {"type": "string", "minLength": 1},
    "accepted": {"type": "boolean"}
  },
  "additionalProperties": true
}

